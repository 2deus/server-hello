### Get room name of room with id 1
GET http://localhost:8080/api/1

### List all rooms
GET http://localhost:8080/api/rooms

### Get room with id 1
GET http://localhost:8080/api/rooms/1

### Get non-existent room
GET http://localhost:8080/api/rooms/1337

### Get rooms with minimum capacity of 10
GET http://localhost:8080/api/rooms?minCapacity=10

### Get rooms with minimum capacity of 999
GET http://localhost:8080/api/rooms?minCapacity=999

### Find all rooms matching keyword
GET http://localhost:8080/api/rooms?keyword=s

### Print number of rooms with min capacity of 10
GET http://localhost:8080/api/rooms/count?minCapacity=10

### Append new room record to end
POST http://localhost:8080/api/rooms
Content-Type: application/json

{
    "name": "Inside",
    "capacity": 20
}

### Append room record with out of bounds capacity
POST http://localhost:8080/api/rooms
Content-Type: application/json

{
  "name": "The World",
  "capacity":  2147483647
}

### replace a room record
PUT http://localhost:8080/api/rooms/2
Content-Type: application/json

{
  "name": "Closets",
  "capacity": 3
}

### Replace a non-existent room record
PUT http://localhost:8080/api/rooms/1337
Content-Type: application/json

{
  "name": "A distant dream",
  "capacity": 1337
}

### replace a room record with out of bounds capacity
PUT http://localhost:8080/api/rooms/2
Content-Type: application/json

{
  "name": "de_dust2",
  "capacity": 32
}

### delete entry
DELETE http://localhost:8080/api/rooms/3

### delete entry which has reservations
DELETE http://localhost:8080/api/rooms/2

### delete non-existent entry
DELETE http://localhost:8080/api/rooms/1337